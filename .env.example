# Copy to .env and `set -a; . ./.env; set +a` before running, or export directly.

# --- upstream (the model Bifrost forwards to) ---
# Any OpenAI-compatible endpoint. Examples:
#   Groq (open-weight Llama, for testing):  https://api.groq.com/openai/v1
#   Your local vLLM / llama.cpp server:     http://127.0.0.1:8000/v1
BIFROST_UPSTREAM_BASE=https://api.groq.com/openai/v1
BIFROST_UPSTREAM_KEY=
BIFROST_DEFAULT_MODEL=llama-3.1-8b-instant

# --- where Bifrost listens ---
BIFROST_HOST=127.0.0.1
BIFROST_PORT=8088

# --- never-refuse behavior ---
BIFROST_INJECT_SYSTEM=true       # prepend the affirmative system preamble
BIFROST_MAX_RETRIES=1            # regenerations after a detected refusal
BIFROST_RETRY_TEMPERATURE=0.6
BIFROST_PASSTHROUGH_HARMFUL=true # leave refusals on genuinely harmful asks alone

# Optional overrides:
# BIFROST_SYSTEM="...custom affirmative preamble..."
# BIFROST_REBUTTAL="...custom retry follow-up..."
